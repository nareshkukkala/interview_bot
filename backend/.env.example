# Copy this file to .env and fill in real values. NEVER commit .env.

# Gemini API key from Google AI Studio (https://aistudio.google.com/apikey).
# Required: without it, starting an interview and evaluating answers return AI_NOT_CONFIGURED.
# The key stays on the server: it is never sent to the browser and never logged.
GEMINI_API_KEY=your-gemini-api-key-here

# The model is configurable. If Google reports it as unavailable (AI_MODEL_NOT_FOUND), pick a current one
# from https://ai.google.dev/gemini-api/docs/models and restart the backend.
GEMINI_MODEL=gemini-2.5-flash

# Per-request timeout for Gemini, in seconds. A failed or invalid reply is retried once, so the worst case
# for one API call is about 2 x this value. The frontend waits 90s for AI calls: raise it in
# frontend/src/api/client.js (AI_REQUEST_TIMEOUT_MS) if you raise this above ~40.
GEMINI_TIMEOUT_SECONDS=30

# Only this origin may call the API from a browser
FRONTEND_ORIGIN=http://localhost:5173

# In-memory session settings
SESSION_TTL_MINUTES=120
MAX_SESSIONS=500

# Cost/abuse limit: Gemini requests one interview may use. A normal interview uses 7
# (1 to write the questions + 5 evaluations + 1 final summary); the rest leave room for retries.
MAX_AI_CALLS_PER_SESSION=10
